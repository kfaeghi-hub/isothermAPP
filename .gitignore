# Logs
logs
*.log
npm-debug.log*

# Dependencies
node_modules

# Build output
dist
dist-ssr
*.local

# Environment files (never commit secrets)
.env
.env.local
.env.*.local

# TypeScript
*.tsbuildinfo

# Vite cache
.vite/

# Test / verification artifacts
verify-ss-*.png
verify-directory.mjs
ss-*.png
# pw-pdf-shot page renders land in the root as out-<stem>-pN.png
out-*.png

# Temporary DOCX/PDF inspection folders
docx-inspect*/

# ShareSync-sourced working copies — CLIENT CONFIDENTIAL, never committed.
# Copies from the firm document store land here and only here.
samples/*
!samples/calibration/
samples/calibration/*
# The drawings never leave the ignore. The MANIFEST is the committed artifact:
# it says what each fixture contains and what each page exercises, so a suite
# can skip LOUDLY by name when a fixture is absent rather than passing on a
# corpus that was not there.
!samples/calibration/FIXTURES.md

# Generated verification artifacts (pw-* script outputs)
out/

# Generated report files at repo root (dev artifacts)
site-report-*.docx
site-report-*.pdf

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Editor/backup debris
*.bak

# Impeccable design hook: share the reviewable ignore config, not the
# per-session dedup cache or per-developer overrides.
.impeccable/hook.cache.json
.impeccable/config.local.json
.shots/
dist-test/
probe.sql

# Rebuildable artifact — the knowledge graph is regenerated by /graphify .
graphify-out/

# Local tool config (root CLAUDE.md stays tracked)
.claude/

# Throwaway diagnostic harnesses. Twice now one has been committed by an
# unthinking `git add -A` (zz-gate3.mjs, zz-g.mjs). The KEEPERS are named
# cal-*.mjs and pw-*.mjs; anything zz-* is scratch by construction.
zz-*.mjs
vite-dev.log

# scratch SQL probes, same rule as zz-*.mjs
zz-*.sql
zz-*.log
zz-*.txt

# The battery's concurrency lock — generated, held only while a run is in flight.
# Untracked and never committed: a lock file in the repo would make every clone
# look like a run was already in progress.
.harness.lock
